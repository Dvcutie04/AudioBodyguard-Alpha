import os, subprocess, time, re
 def s(m): os.system(f"say {m}")
 l = "GREEN"
 print("--- SENTINEL LIVE ---")
 while True:
     try:
         o = subprocess.check_output(["ping","-c","1","-W","1","8.8.8.8"], universal_newlines=True)
         v = float(re.search(r"time=(\d+\.?\d*)", o).group(1))
     except: v = 999
     c = "GREEN" if v < 150 else "RED"
     if c != l:
         s("Online" if c == "GREEN" else "Lost")
         l = c
     print(f"[{time.strftime('%H:%M:%S')}] {c} | {v}ms")
     time.sleep(0.5)
 
exit()
