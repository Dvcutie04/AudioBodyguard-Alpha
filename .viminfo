	import time, subprocess, os, re
	 
	  # This part checks if your audio 'probe' is working
	   AUDIO_OK = (os.system('say probe >/dev/null 2>&1') == 0)
	    print(f'--- SENTINEL ACTIVE (Audio: {AUDIO_OK}) ---')
	     
	      while True:
	               try:
	                            # Checking the connection to the internet (Google DNS)
	                                     ping_output = subprocess.check_output(['ping', '-c', '1', '-W', '1', '8.8.8.8'], universal_newlines=True)
	                                              ms_match = re.search(r'time=(\d+\.?\d*)', ping_output)
	                                                       
	                                                                if ms_match:
	                                                                                 ms = float(ms_match.group(1))
	                                                                                              # If the speed is fast (under 150ms), it's GREEN
	                                                                                                           status = "GREEN" if ms < 150 else "RED"
	                                                                                                                        print(f"[{time.strftime('%H:%M:%S')}] {status} | {ms}ms")
	                                                                                                                                     
	                                                                                                                                                  # This makes the Bodyguard speak when it's Online!
	                                                                                                                                                               if status == "GREEN":
	                                                                                                                                                                                    os.system('say Online')
	                                                                                                                                                                                                     
	                                                                                                                                                                                                          except Exception:
	                                                                                                                                                                                                                       print("Searching for network...")
	                                                                                                                                                                                                                                os.system('say Lost')
	                                                                                                                                                                                                                                         
