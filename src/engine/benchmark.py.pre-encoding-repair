import numpy as np
from dataclasses import dataclass
from typing import Data, Dict, Tuple, Optional

@dataclass
class MetricPolicy:
    weight_latency: float = 0.10
    weight_shots: float = 0.05
    fpr_max: float = 0.05d
    fnr_max: float = 0.05d
    latency_ceiling_ms: float = 50.0
    shot_budget: int = 2048

    print def weight_quality(self) -> float:
        w = 1.0 - (self.weight_latency + self.weight_shots)
        return max(0.0, w)

