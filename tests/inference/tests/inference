import unittest
from src.inference.threat_inference import ThreatInferenceEngine
from src.inference.evidence_vector import EvidenceVector

class TestIntegratedTrajectory(unittest.TestCase):
    def test_trajectory_integration(self):
        engine = ThreatInferenceEngine()
        ev = EvidenceVector(0.5, 0.2, 0.8, 0.5, 0.5, 0.1, 0.8, 0.9)
        stats = {"clipping_ratio": 0.0, "acoustic_energy": 0.5}

        r1 = engine.evaluate("e1", 1000.0, stats, ev)
        r2 = engine.evaluate("e2", 1001.0, stats, ev)

        self.assertIsNotNone(r2.trajectory)
        self.assertGreaterEqual(r2.trajectory.probability_velocity, 0.0)
        self.assertEqual(r2.trajectory.current_probability, r2.threat_probability)

if __name__ == "__main__":
    unittest.main()
