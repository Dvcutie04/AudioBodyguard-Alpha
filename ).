mport time
 import threading
  import random
   from queue import Queue
    
     # --- 1. CONFIGURATION & OMONTENASHI CONSTANTS ---
      SAFE_MIN, SAFE_MAX = 75.0, 95.0
       BASELINE_MUTE = 85.0
        UNMUTE_OFFSET = 20.0  # Unmute at (Threshold - 20dB)
         
          # Learning & Safety
           DECAY_RATE = 0.05       # dB dropped every 5 seconds to return to baseline
            LEARN_COOLDOWN = 5.0    # Minimum seconds between learning updates
             WATCHDOG_TIMEOUT = 12.0 # Force unmute if stuck for 12 seconds
              
               # Haptic Pattern Mapping
                HAPTIC_PATTERNS = {
                             "auto_mute":       "Single Medium (Notice)",
                                  "auto_unmute":     "Single Soft (Whisper)",
                                       "override_unmute": "Double Soft (Learning)",
                                            "watchdog_unmute": "Long Soft (Reassurance)",
                                                 "manual_mute":     "Single Medium (User Action)"
                                                  }
                 
                 # --- 2. SHARED SYSTEM STATE ---
                  profile = {"mute_thresh": BASELINE_MUTE}
                   state = {"muted": False, "mute_start": None}
                    event_queue = Queue()
                     lock = threading.Lock()
                      
                       # --- 3. HARDWARE STUBS (Replace with real SDK calls later) ---
                        def get_decibels():
                                 # Simulates varying noise levels
                                      return random.uniform(50, 95)
                                   
                                   def set_hardware_mute(flag):
                                            status = "OFF 🔇" if flag else "ON  🔊"
                                                 print(f"\n[AUDIO] System is now {status}")
                                                  
                                                   def trigger_haptic(event_name):
                                                            pattern = HAPTIC_PATTERNS.get(event_name, "Standard Pulse")
                                                                 print(f"[HAPTIC] {pattern}")
                                                                  
                                                                   # --- 4. THE LEARNING BRAIN ---
                                                                    def apply_learning(level, last_time):
                                                                             now = time.time()
                                                                                  if now - last_time < LEARN_COOLDOWN:
                                                                                               return last_time
                                                                                            
                                                                                                # Calculate how much to adjust based on the current noise spike
                                                                                                     delta = (level - profile["mute_thresh"]) / 2.0
                                                                                                          delta = max(0.5, min(3.0, delta)) # Don't jump more than 3dB at once
                                                                                                               
                                                                                                                    with lock:
                                                                                                                                 profile["mute_thresh"] = max(SAFE_MIN, min(profile["mute_thresh"] + delta, SAFE_MAX))
                                                                                                                                      
                                                                                                                                           print(f"\n[LEARN] Threshold adapted to {profile['mute_thresh']:.1f} dB")
                                                                                                                                                return now
                                                                                                                                             
                                                                                                                                             # --- 5. THE INPUT LISTENER (Running in Thread) ---
                                                                                                                                              def keyboard_listener():
                                                                                                                                                       print("Commands: [u] Override/Unmute | [m] Force Mute | [q] Quit")
                                                                                                                                                            while True:
                                                                                                                                                                         cmd = input().strip().lower()
                                                                                                                                                                                  if cmd: event_queue.put(cmd)
                                                                                                                                                                                           if cmd == 'q': break
                                                                                                                                                                                            
                                                                                                                                                                                             # --- 6. THE MAIN OMOTENASHI LOOP ---
                                                                                                                                                                                              def main():
                                                                                                                                                                                                       last_learn_time = 0.0
                                                                                                                                                                                                            last_decay_time = time.time()
                                                                                                                                                                                                                 
                                                                                                                                                                                                                      t = threading.Thread(target=keyboard_listener, daemon=True)
                                                                                                                                                                                                                           t.start()
                                                                                                                                                                                                                            
                                                                                                                                                                                                                                 print("--- Audio Bodyguard Active ---")
                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                           try:
                                                                                                                                                                                                                                                        while True:
                                                                                                                                                                                                                                                                         now = time.time()
                                                                                                                                                                                                                                                                                      level = get_decibels()
                                                                                                                                                                                                                                                                                                   unmute_limit = profile["mute_thresh"] - UNMUTE_OFFSET
                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                 # A. Process User Input
                                                                                                                                                                                                                                                                                                                              while not event_queue.empty():
                                                                                                                                                                                                                                                                                                                                                   cmd = event_queue.get()
                                                                                                                                                                                                                                                                                                                                                                    if cmd == 'q': return
                                                                                                                                                                                                                                                                                                                                                                                     elif cmd == 'u' and state["muted"]:
                                                                                                                                                                                                                                                                                                                                                                                                              set_hardware_mute(False)
                                                                                                                                                                                                                                                                                                                                                                                                                                   state.update({"muted": False, "mute_start": None})
                                                                                                                                                                                                                                                                                                                                                                                                                                                        trigger_haptic("override_unmute")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                             last_learn_time = apply_learning(level, last_learn_time)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              elif cmd == 'm':
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       set_hardware_mute(True)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            state.update({"muted": True, "mute_start": now})
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 trigger_haptic("manual_mute")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               # B. Automatic Logic
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            with lock:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 # 1. Trigger Mute
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if not state["muted"] and level > profile["mute_thresh"]:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           set_hardware_mute(True)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                state.update({"muted": True, "mute_start": now})
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     trigger_haptic("auto_mute")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          print(f"[ACTION] Noise Spike: {level:.1f} dB")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            # 2. Trigger Unmute
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             elif state["muted"] and level < unmute_limit:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      set_hardware_mute(False)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           state.update({"muted": False, "mute_start": None})
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                trigger_haptic("auto_unmute")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     print(f"[ACTION] Environment Safe: {level:.1f} dB")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       # 3. Watchdog Safety
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        elif state["muted"] and (now - state["mute_start"] > WATCHDOG_TIMEOUT):
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 set_hardware_mute(False)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      state.update({"muted": False, "mute_start": None})
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           trigger_haptic("watchdog_unmute")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                print("[SAFETY] Watchdog timeout: Restoring audio.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              # C. Gentle Decay (Slowly return to baseline)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           if now - last_decay_time > 5.0:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if profile["mute_thresh"] > BASELINE_MUTE:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         profile["mute_thresh"] -= DECAY_RATE
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          last_decay_time = now
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        time.sleep(0.5)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             except KeyboardInterrupt:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          print("\nShutting down gracefully...")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if __name__ == "__main__":
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     main()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
