mport numpy as np
 import asyncio
 import time
 
 # ---- HARD CONSTRAINTS (40MB Ceiling) ----
 RING_BUFFER_FRAMES = 512
 FRAME_SIZE = 512
 QUEUE_MAXSIZE = 4
 DTYPE_AUDIO = np.int16
 
 class AudioCore:
     def __init__(self):
         self.ring_buffer = np.zeros((RING_BUFFER_FRAMES, FRAME_SIZE), dtype=DTYPE_AUDIO)
         self.write_ptr = 0
         self.queue = asyncio.Queue(maxsize=QUEUE_MAXSIZE)
 
     def hot_path_callback(self, frame):
         self.ring_buffer[self.write_ptr] = frame
         self.write_ptr = (self.write_ptr + 1) % RING_BUFFER_FRAMES
         try:
             self.queue.put_nowait(frame)
         except asyncio.QueueFull:
             try:
                 self.queue.get_nowait()
                 self.queue.put_nowait(frame)
             except: pass
 
 def extract_features(frame):
     sig = frame.astype(np.float32)
     energy = np.sum(sig**2) / len(sig)
     fft_mag = np.abs(np.fft.rfft(sig))
     fan_band = np.mean(fft_mag[10:50]) 
     return np.array([energy, fan_band], dtype=np.float32)
 
 async def inference_loop(core):
     print("Inference Loop Active. Monitoring for Workstation Drift...")
     while True:
         frame = await core.queue.get()
         start_time = time.perf_counter()
         features = extract_features(frame)
         proc_time = (time.perf_counter() - start_time) * 1000
         if proc_time > 5.0:
             print(f"LATENCY WARNING: {proc_time:.2f}ms")
         core.queue.task_done()
 
 async def main():
     core = AudioCore()
     asyncio.create_task(inference_loop(core))
     while True:
         fake_frame = np.random.randint(-100, 100, FRAME_SIZE, dtype=DTYPE_AUDIO)
         core.hot_path_callback(fake_frame)
         await asyncio.sleep(0.032)
 
 if __name__ == "__main__":
     asyncio.run(main())

